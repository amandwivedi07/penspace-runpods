# RunPod Serverless image for the Penspace narration renderer.
#
# Same renderer as penspace/Dockerfile — the difference is what happens at
# startup. A batch Pod boots once and runs for hours, so pulling weights from
# Hugging Face at boot is a rounding error. A serverless worker boots every time
# the endpoint scales up, and RunPod bills that boot, so the weights are BAKED
# IN here rather than downloaded. A ~7 GB image pulls from RunPod's registry
# cache far faster than the same bytes come from Hugging Face, and it cannot
# fail halfway because HF is rate-limiting you.
#
#   docker build -t <user>/penspace-tts:1 -f penspace/Dockerfile.serverless .
#   docker push <user>/penspace-tts:1
#
# Then point a RunPod Serverless endpoint at that tag. See DEPLOY_SERVERLESS.md.

# CUDA 12.8, not the 12.4 the batch image uses.
#
# RunPod's 24 GB serverless tier allocates RTX PRO 6000 MIG partitions, which
# are Blackwell (sm_120). Wheels built against CUDA 12.4 carry no kernels for
# that architecture, and the mismatch ABORTS the process rather than raising —
# the worker dies with a bare "exit code 1" and no traceback. Older tiers avoid
# it but their supply is thin, so the fix belongs in the image.
FROM pytorch/pytorch:2.8.0-cuda12.8-cudnn9-devel

# HF_HOME is where the model cache lands. Override it to a mounted Network
# Volume path (e.g. /runpod-volume/hf) to share one download across workers.
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/models \
    PENSPACE_WORK_DIR=/work

RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg git sox libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY penspace/requirements.txt penspace/requirements-serverless.txt /app/penspace/
RUN pip install --no-cache-dir -r penspace/requirements-serverless.txt

# FlashAttention 2 is attempted but NOT required.
#
# `resolve_attn` asks for flash_attention_2 on any CUDA device, so a failed
# build here would make the model load raise at runtime instead of degrading.
# Pinning PENSPACE_ATTN=sdpa below removes that trap: sdpa is slower and uses
# more VRAM, but it works everywhere. Drop the ENV if a build succeeds and you
# want the speed back.
RUN MAX_JOBS=4 pip install --no-cache-dir -U flash-attn --no-build-isolation || \
    echo "flash-attn build failed — sdpa is pinned below, so this is survivable"
ENV PENSPACE_ATTN=sdpa

# The Qwen weights are NOT baked in.
#
# They were, and it made the image 13.85 GB. Every serverless worker pulls the
# whole image before executing a line, and at that size workers stopped becoming
# ready at all — jobs queued behind an endpoint stuck "Initializing". A worker
# that starts and downloads is strictly better than one that never starts.
#
# Two ways to avoid paying for the download repeatedly:
#   1. Attach a RunPod Network Volume and point HF_HOME at it (see below), so the
#      first worker populates the cache and the rest mount it.
#   2. Rely on warm workers — the cache survives while a worker is alive, so a
#      batch of chapters downloads once.
#
# The CLI tooling is still installed so a volume can be pre-populated.
RUN pip install --no-cache-dir -U "huggingface_hub[cli]"

# The Whisper QA model too: it is small, but a cold worker downloading it is a
# cold worker you are paying to wait.
ARG WHISPER_MODEL=small.en
RUN python -c "from faster_whisper import WhisperModel; WhisperModel('$WHISPER_MODEL', device='cpu', compute_type='int8')"

# Keep the baked model and the one the runner asks for in lockstep. If they
# diverge, the worker quietly downloads a second model on its first request —
# billed, and slow, in exactly the place this file exists to avoid.
ENV PENSPACE_WHISPER_MODEL=$WHISPER_MODEL

COPY penspace /app/penspace

# The reference recording for voice cloning. Baked in so the voice cannot drift
# between workers, and so an endpoint needs no volume mounted just to hold one
# small file. This is the narrator's own take, slate trimmed; it replaced
# penspace_ref.mp3, a different take that predated it. Set PENSPACE_REF_AUDIO
# to /app/julian_ref_clean.mp3.
COPY julian_ref_clean.mp3 /app/julian_ref_clean.mp3

# Julian 2.0 — a second take from the narrator, on trial against the one above.
#
# Cut from a 60-second recording that began and ended mid-sentence: this is
# 2.225s to 23.035s, five complete sentences, with 20ms fades so the cut does
# not click. Twenty seconds is inside the range cloning uses; the full minute
# adds nothing about the voice and makes the clone prompt slower to build on
# every boot.
#
# It is the same Atomic Habits passage as an earlier GENERATED file, which is
# worth knowing — but waveform correlation against that file is 0.047, so this
# is its own recording, not a clone of a clone.
#
# PENSPACE_REF_TEXT for this clip is julian_ref_v2.txt, word for word. It is
# NOT the transcript of julian_ref_clean.mp3: switching PENSPACE_REF_AUDIO
# without switching the text degrades the clone and changes every render id.
COPY julian_ref_v2.mp3 /app/julian_ref_v2.mp3
COPY julian_ref_v2.txt /app/julian_ref_v2.txt

RUN mkdir -p /work

CMD ["python", "-u", "-m", "penspace.handler"]
